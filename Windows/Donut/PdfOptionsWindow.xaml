<Window x:Class="Donut.PdfOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF export"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FDFDFC">
  <StackPanel Margin="24">
    <TextBlock Text="PDF export"
               FontSize="20"
               FontWeight="SemiBold"
               Foreground="#202124"/>
    <TextBlock Text="How should the dropped images be exported?"
               Margin="0,8,0,18"
               Foreground="#77797D"
               TextWrapping="Wrap"/>
    <RadioButton x:Name="MergeButton"
                 Content="Merge all images into one PDF"
                 IsChecked="True"
                 Margin="0,0,0,12"
                 FontSize="13"/>
    <RadioButton x:Name="SeparateButton"
                 Content="Create a separate PDF for each image"
                 FontSize="13"/>
    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,24,0,0">
      <Button Content="Cancel"
              IsCancel="True"
              Padding="18,8"
              Margin="0,0,8,0"/>
      <Button Content="Continue"
              IsDefault="True"
              Padding="18,8"
              Click="Continue_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
