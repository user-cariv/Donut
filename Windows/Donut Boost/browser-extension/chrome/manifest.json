{
  "manifest_version": 3,
  "name": "Send to Donut Boost",
  "version": "1.0.6",
  "description": "Send a direct download link or magnet link from Chrome to Donut Boost.",
  "icons": {
    "16": "icons/boost-16.png",
    "32": "icons/boost-32.png",
    "48": "icons/boost-48.png",
    "128": "icons/boost-128.png"
  },
  "action": {
    "default_title": "Send to Donut Boost",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/boost-16.png",
      "32": "icons/boost-32.png"
    }
  },
  "permissions": ["contextMenus", "storage", "alarms"],
  "optional_permissions": ["downloads", "nativeMessaging", "cookies"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "service-worker.js" }
}
