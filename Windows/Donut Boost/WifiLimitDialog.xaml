<Window x:Class="DonutBoost.WifiLimitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wi-Fi speed limit" Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Foreground="#FFF2E2" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFF2E2"/>
            <Setter Property="Background" Value="#231E2D"/>
            <Setter Property="BorderBrush" Value="#504053"/>
            <Setter Property="Padding" Value="9,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="10" BorderThickness="1"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#FFAE43"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <LinearGradientBrush x:Key="Gold" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFC370"/>
            <GradientStop Color="#FF9108" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>
    <Border CornerRadius="22" BorderThickness="1" BorderBrush="#795132" Padding="24">
        <Border.Background>
            <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                <GradientStop Color="#302331"/>
                <GradientStop Color="#191524" Offset="0.42"/>
                <GradientStop Color="#14111D" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="×" IsCancel="True" Padding="9,2"
                        VerticalAlignment="Top" AutomationProperties.Name="Close"/>
                <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="11" Background="{StaticResource Gold}" Margin="0,0,11,0">
                    <Path x:Name="ConnectionIcon" Width="18" Height="18" Stretch="Uniform" Stroke="#2A180B" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M2.5,8 A15,15 0 0 1 21.5,8 M5.5,12 A10,10 0 0 1 18.5,12 M9,16 A4.5,4.5 0 0 1 15,16 M11.8,19.5 H12.2"/>
                </Border>
                <StackPanel>
                    <TextBlock x:Name="DialogHeading" Text="Wi-Fi speed limit" FontFamily="Georgia" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Applies to Donut downloads only" Foreground="#C5B6D3" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
            <Grid Height="158" Margin="0,19,0,4">
                <Canvas Width="260" Height="150" HorizontalAlignment="Center">
                    <Path Stroke="#302A3A" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M12,128 A118,118 0 0 1 248,128"/>
                    <Path x:Name="RateArc" Stroke="{StaticResource Gold}" StrokeThickness="11"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Ellipse x:Name="RateDot" Width="19" Height="19" Fill="#FFF8EC" Stroke="#FFA326" StrokeThickness="3"/>
                    <TextBlock Canvas.Left="2" Canvas.Top="138" Text="10" Foreground="#C5B6D3" FontSize="10"/>
                    <TextBlock Canvas.Right="2" Canvas.Top="138" Text="50" Foreground="#C5B6D3" FontSize="10"/>
                </Canvas>
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,21">
                    <TextBlock x:Name="Readout" FontFamily="Georgia" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ReadoutUnit" Text="MBPS" FontWeight="Bold" FontSize="10" Foreground="#FFAF42" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
            <UniformGrid x:Name="Presets" Columns="5" Margin="-3,0">
                <Button Content="10" Tag="10" Click="Preset_Click" Margin="3,0"/>
                <Button Content="20" Tag="20" Click="Preset_Click" Margin="3,0"/>
                <Button Content="30" Tag="30" Click="Preset_Click" Margin="3,0"/>
                <Button Content="40" Tag="40" Click="Preset_Click" Margin="3,0"/>
                <Button Content="50" Tag="50" Click="Preset_Click" Margin="3,0"/>
            </UniformGrid>
            <DockPanel Margin="0,14,0,5">
                <Button DockPanel.Dock="Right" Content="Unlimited" Click="Unlimited_Click" Padding="6,2" FontSize="10"/>
                <Label Content="Custom speed" Target="{Binding ElementName=CustomSpeed}" Foreground="#FFF2E2" Padding="0" VerticalAlignment="Center"/>
            </DockPanel>
            <Border Background="#100D18" BorderBrush="#45374A" BorderThickness="1" CornerRadius="10" Padding="10,7">
                <DockPanel>
                    <TextBlock Text="Mbps" DockPanel.Dock="Right" Foreground="#FFAF42" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="CustomSpeed" Background="Transparent" BorderThickness="0" Foreground="#FFF2E2"
                             CaretBrush="#FFF2E2" TextChanged="CustomSpeed_Changed" AutomationProperties.Name="Custom speed in Mbps"/>
                </DockPanel>
            </Border>
            <TextBlock x:Name="InputError" Text="Enter a speed from 0.1 to 100,000 Mbps." Foreground="#FFB1A6"
                       Margin="0,6,0,0" Visibility="Collapsed"/>
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="Cancel" IsCancel="True" Margin="0,0,4,0"/>
                <Button Grid.Column="1" Content="Save limit" IsDefault="True" Click="Save_Click" Margin="4,0,0,0"
                        Background="{StaticResource Gold}" Foreground="#281609" FontWeight="Bold"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
