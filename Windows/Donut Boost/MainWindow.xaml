<Window x:Class="DonutBoost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Donut Boost — Network Monitor and Direct Downloader"
        Icon="Assets/Donut.ico"
        WindowState="Maximized"
        Height="800" Width="1100"
        MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#09080E"
        FontFamily="{StaticResource AppleFontFamily}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <SolidColorBrush x:Key="EthernetOnlineBrush" Color="#FFAB61"/>
        <LinearGradientBrush x:Key="PreviewCardBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B0443C59" Offset="0"/><GradientStop Color="#92241F37" Offset="0.19"/>
            <GradientStop Color="#771A1729" Offset="0.67"/><GradientStop Color="#92322A42" Offset="1"/>
        </LinearGradientBrush>
    <LinearGradientBrush x:Key="PreviewGlassEdge" StartPoint="0,0" EndPoint="0.75,1"><GradientStop Color="#A5B0A4CC"/><GradientStop Color="#4B544B63" Offset="0.30"/><GradientStop Color="#82796C92" Offset="1"/></LinearGradientBrush></Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Apple Title Bar (Row 0 - Fixed) -->
            <RowDefinition Height="*"/>    <!-- Main Scrollable Content Area (Row 1) -->
            <RowDefinition Height="Auto"/> <!-- Apple Status Bar (Row 2 - Fixed) -->
        </Grid.RowDefinitions>

        <Grid x:Name="WallpaperViewport" Grid.RowSpan="3" ClipToBounds="True" IsHitTestVisible="False">
            <Grid.Resources>
                    <RadialGradientBrush x:Key="WallpaperGlowBrush" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#92552508"/>
                        <GradientStop Color="#69582B0B" Offset="0.28"/>
                        <GradientStop Color="#30582B0B" Offset="0.63"/>
                        <GradientStop Color="#00582B0B" Offset="1"/>
                    </RadialGradientBrush>
            </Grid.Resources>
            <Grid>
                <Grid.RenderTransform><TranslateTransform x:Name="WallpaperTravel"/></Grid.RenderTransform>
                <Ellipse x:Name="WallpaperGlow" Width="940" Height="690" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Fill="{StaticResource WallpaperGlowBrush}">
                    <Ellipse.CacheMode><BitmapCache/></Ellipse.CacheMode>
                </Ellipse>
                <Ellipse x:Name="WallpaperUpperGlow" Width="740" Height="550" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Fill="{StaticResource WallpaperGlowBrush}" Opacity="0">
                    <Ellipse.CacheMode><BitmapCache/></Ellipse.CacheMode>
                    <Ellipse.RenderTransform><TranslateTransform x:Name="WallpaperUpperTravel"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="WallpaperLowerGlow" Width="700" Height="510" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Fill="{StaticResource WallpaperGlowBrush}" Opacity="0">
                    <Ellipse.CacheMode><BitmapCache/></Ellipse.CacheMode>
                    <Ellipse.RenderTransform><TranslateTransform x:Name="WallpaperLowerTravel"/></Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
        </Grid>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="#A809080E" Height="46" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="18,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Left: Traffic Lights & Brand -->
                    <ColumnDefinition Width="*"/>    <!-- Center: Sticky Live Status -->
                    <ColumnDefinition Width="Auto"/> <!-- Right: Actions & Window Controls -->
                </Grid.ColumnDefinitions>

                <!-- Left: Brand Header & License Status -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Image Source="Assets/DonutBoostLogo.png" Width="24" Height="24" Margin="0,0,8,0"/>
                    <TextBlock Text="Donut Boost" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"/>

                    <!-- License Status Pill (Click to view details or renew) -->
                    <Button x:Name="TitleBarLicenseButton" Click="TitleBarLicenseButton_Click" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Margin="10,0,0,0" ToolTip="Click to view license status or enter a new redeem code">
                        <Border x:Name="TitleBarLicenseBadge" Background="#251B0B" BorderBrush="#745019" BorderThickness="1" CornerRadius="12" Padding="10,4">
                            <TextBlock x:Name="TitleBarLicenseText" Text="⚡ PRO: ACTIVE" FontSize="10" FontWeight="Bold" Foreground="#FFC256"/>
                        </Border>
                    </Button>

                    <!-- Eye-Catching Official Website CTA Button (Next to License Status) -->
                    <Button Click="OpenWebsiteButton_Click" Cursor="Hand" Margin="10,0,0,0" ToolTip="Visit Official Donut Website (https://user-cariv.github.io/Donut/)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="WebBadgeBorder" CornerRadius="15" Padding="13,5" BorderThickness="1" SnapsToDevicePixels="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#291D10" Offset="0.0"/>
                                            <GradientStop Color="#211830" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.BorderBrush>
                                        <LinearGradientBrush><GradientStop Color="#FFAC31"/><GradientStop Color="#9978EE" Offset="1"/></LinearGradientBrush>
                                    </Border.BorderBrush>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🌐" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Website" FontSize="12" FontWeight="SemiBold" Foreground="#FFF0D8" VerticalAlignment="Center"/>
                                        <TextBlock Text="↗" FontSize="11" FontWeight="Black" Foreground="#FFF0D8" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="WebBadgeBorder" Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FFCB72" Offset="0.0"/>
                                                    <GradientStop Color="#FFAA2C" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="WebBadgeBorder" Property="BorderBrush" Value="#FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="WebBadgeBorder" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- In-App Update Ready Badge (Top bar alert) -->
                    <Button x:Name="TitleBarUpdateBadge" Click="TitleBarUpdateBadge_Click" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Margin="8,0,0,0" ToolTip="New update is ready! Click to view update details">
                        <Border Background="#2E1065" BorderBrush="#A855F7" BorderThickness="1" CornerRadius="8" Padding="7,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚀 " FontSize="10"/>
                                <TextBlock x:Name="TitleBarUpdateBadgeText" Text="UPDATE READY" FontSize="10" FontWeight="Bold" Foreground="#DDD6FE"/>
                            </StackPanel>
                        </Border>
                    </Button>
                </StackPanel>

                <!-- Center: Live Sticky Status Capsule (Always visible when scrolling) -->
                <Grid Grid.Column="1" Visibility="Collapsed">
                    <StackPanel x:Name="TitleBarLiveStatusPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <Border Background="#241E15" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="12" Padding="14,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TitleBarSpeedTextBlock" Text="0.0 Mbps" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                                <TextBlock x:Name="TitleBarStatusBadge" Text="BOOSTING SPEED" FontWeight="Bold" FontSize="11" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock x:Name="TitleBarProgressText" Text="0% (ETA: --:--)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Right: Utility & Windows Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">

                    <Button x:Name="WifiRoutePreferenceButton" Visibility="Collapsed" Click="PreferWifiRouteButton_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" Margin="0,0,8,0" ToolTip="Restore Windows network settings saved by an older version of Donut Boost.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📶" FontSize="11" Margin="0,0,6,0"/>
                            <TextBlock x:Name="WifiRoutePreferenceText" Text="Prefer Wi-Fi" FontSize="11" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                    <Button Click="RefreshAdaptersButton_Click" Background="#1C1E27" BorderBrush="Transparent" Foreground="#E5E8F3"
                            MinHeight="32" Padding="15,5" Margin="0,6,10,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="Refresh network adapters and connected phones">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="RescanSurface" CornerRadius="17" Background="{TemplateBinding Background}"
                                        BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="RescanSurface" Property="Background" Value="#292E3B"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="RescanSurface" Property="Background" Value="#222632"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="RescanSurface" Property="BorderBrush" Value="#80D9EF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Prefer Wi-Fi for Windows" Click="PreferPreviewWifi_Click"/><MenuItem Header="Check for updates" Click="CheckForUpdatesButton_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" FontSize="11" Margin="0,0,6,0"/>
                            <TextBlock Text="Rescan connections" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="20" Background="#2C303D" Margin="0,0,9,0" VerticalAlignment="Center"/>
                    <Button Click="MinimizeButton_Click" Style="{StaticResource WindowControlButtonStyle}" ToolTip="Minimize">
                        <TextBlock Text="—" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Click="MaximizeRestoreButton_Click" Style="{StaticResource WindowControlButtonStyle}" ToolTip="Maximize / Restore">
                        <TextBlock x:Name="MaximizeIconText" Text="🗖" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                    <Button Click="CloseButton_Click" Style="{StaticResource WindowCloseButtonStyle}" ToolTip="Keep Donut Boost running in the notification area">
                        <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Dashboard -->
        <Grid Grid.Row="1" Margin="22,12,22,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0. In-App Auto-Update Banner -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 0. In-App Auto-Update Notification Banner (Appears when new version is available) -->
                <Border x:Name="AppUpdateBanner" Grid.Row="0" Visibility="Collapsed" Background="{StaticResource PreviewCardBrush}" BorderBrush="#8B5CF6" BorderThickness="1.5" CornerRadius="12" Margin="0,0,0,8" Padding="16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Icon -->
                        <Border Grid.Column="0" Background="#2E1065" CornerRadius="10" Width="38" Height="38" Margin="0,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🚀" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Center: Update Info & Progress -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock x:Name="UpdateBannerTitle" Text="New Donut Boost Update Available" FontSize="13" FontWeight="Bold" Foreground="#EDE9FE"/>
                                <Border Background="#4C1D95" CornerRadius="6" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="UpdateVersionTag" Text="v1.0.8" FontSize="10" FontWeight="Bold" Foreground="#DDD6FE"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="UpdateReleaseNotesText" Text="Keep Windows on home Wi-Fi, improve adapter monitoring, and show verified Steam download progress." FontSize="11" Foreground="#C4B5FD" TextWrapping="Wrap"/>
                            <TextBlock Text="Donut Boost needs to restart after installing the update. If it doesn't reopen automatically, open it from the Windows Start menu."
                                       Margin="0,6,0,0" FontSize="11" Foreground="#E9D5FF" TextWrapping="Wrap"/>

                            <!-- Download Progress Strip -->
                            <Grid x:Name="UpdateProgressPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ProgressBar x:Name="UpdateProgressBar" Height="6" Value="0" Maximum="100" Background="#2E1065" Foreground="#A855F7" BorderThickness="0"/>
                                <TextBlock x:Name="UpdateProgressPercentText" Grid.Row="1" Text="Downloading update... 0%" FontSize="10" Foreground="#DDD6FE" Margin="0,4,0,0"/>
                            </Grid>
                        </StackPanel>

                        <!-- Right: Actions -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <Button x:Name="UpdateNowButton" Click="UpdateNowButton_Click" Style="{StaticResource BoostButtonStyle}" Padding="14,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⬇" Margin="0,0,6,0" FontWeight="Bold"/>
                                    <TextBlock x:Name="UpdateNowButtonText" Text="Update Now" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1"><Grid.Background><RadialGradientBrush Center="0.94,0.12" GradientOrigin="0.94,0.12" RadiusX="0.46" RadiusY="0.75"><GradientStop Color="#592B2053"/><GradientStop Color="#002B2053" Offset="1"/></RadialGradientBrush></Grid.Background>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="69*"/><ColumnDefinition Width="30*"/></Grid.ColumnDefinitions>

                    <StackPanel Margin="0,3,9,0">
                        <StackPanel.Resources>
                            <Style x:Key="RailGlass" TargetType="RadioButton">
                                <Setter Property="Width" Value="45"/>
                                <Setter Property="Height" Value="45"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Foreground" Value="#D7D2E4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="13">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Surface" Property="Background" Value="#242030"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Foreground" Value="#FFC256"/>
                                                    <Setter TargetName="Surface" Property="BorderBrush" Value="#846023"/>
                                                    <Setter TargetName="Surface" Property="Background">
                                                        <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#403019"/><GradientStop Color="#18120C" Offset="1"/></LinearGradientBrush></Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Surface" Property="BorderBrush" Value="#FFC256"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>
                        <RadioButton x:Name="DownloadsNavigationButton" GroupName="PreviewNavigation" IsChecked="True" Click="ShowPreviewDownloads_Click" Style="{StaticResource RailGlass}" HorizontalAlignment="Left" ToolTip="Downloads" AutomationProperties.Name="Downloads">
                            <Path Data="M12,3 L12,15 M7,10.5 L12,15.5 L17,10.5 M4.5,20 L19.5,20" Width="20" Height="20" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </RadioButton>
                        <RadioButton GroupName="PreviewNavigation" Click="ShowPreviewLog_Click" Style="{StaticResource RailGlass}" HorizontalAlignment="Left" Margin="0,9,0,0" ToolTip="System log" AutomationProperties.Name="System log">
                            <Path Data="M7.5,3 H16.5 A3,3 0 0 1 19.5,6 V18 A3,3 0 0 1 16.5,21 H7.5 A3,3 0 0 1 4.5,18 V6 A3,3 0 0 1 7.5,3 Z M8.5,8.5 H15.5 M8.5,12 H15.5 M8.5,15.5 H12.5" Width="20" Height="20" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </RadioButton>
                    </StackPanel>

                    <Grid x:Name="PreviewDownloadColumn" Grid.Column="1" Margin="0,0,28,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border>

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="#121214" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="4,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🔗" FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,0,6,0"/>
                                        <TextBlock Grid.Column="1" Text="1GB.bin" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Example file name"/>
                                        <TextBox x:Name="UrlTextBox" Grid.Column="2" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Background="Transparent" BorderThickness="0" Padding="4,7" VerticalContentAlignment="Center" AutomationProperties.Name="Download link" ToolTip="Direct HTTP(S) URL, magnet link, or path to a .torrent file"/>
                                        <TextBlock Grid.Column="2" Text="Paste a download link" Margin="4,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=UrlTextBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <Button x:Name="PasteDownloadButton" Grid.Column="1" MinHeight="36" Padding="12,5" Click="PasteUrlButton_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" ToolTip="Paste URL from Clipboard">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📋" FontSize="11" Margin="0,0,5,0"/>
                                        <TextBlock Text="Paste"/>
                                    </StackPanel>
                                </Button>


                                <Button x:Name="TorrentDownloadButton" Grid.Column="2" MinHeight="36" Padding="12,5" Click="SelectTorrentButton_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" ToolTip="Choose a torrent or Usenet NZB file">
                                    <TextBlock Text="Torrent / NZB"/>
                                </Button>

                                <Button x:Name="StartBoostButton" Grid.Column="3" MinWidth="155" MinHeight="38" FontSize="15" Padding="14,5" Click="StartBoostButton_Click" Style="{StaticResource BoostButtonStyle}" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡" FontSize="13" Margin="0,0,6,0"/>
                                        <TextBlock Text="Download"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        <ScrollViewer x:Name="PreviewDownloadView" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                        <Expander Header="Download queue" Margin="0,6,0,8" Foreground="{StaticResource TextPrimaryBrush}">
                            <StackPanel Margin="0,6,0,0">
                                <WrapPanel>
                                    <TextBox x:Name="QueueScheduleText" Width="70" MaxLength="5" ToolTip="Optional local start time in HH:mm"
                                             AutomationProperties.Name="Optional start time in HH:mm" Margin="0,0,8,0"/>
                                    <Button Content="Add to queue" Click="AddManualDownloadToQueue_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                                    <Button Content="Retry selected" Click="RetryQueuedDownload_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                                    <Button Content="Remove selected" Click="RemoveQueuedDownload_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                </WrapPanel>
                                <TextBlock x:Name="QueueFeedback" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ListView x:Name="DownloadQueueList" MaxHeight="147" Margin="0,5,0,0"
                                          Background="{StaticResource SurfaceSubtleBrush}" Foreground="{StaticResource TextPrimaryBrush}">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Download" DisplayMemberBinding="{Binding Name}" Width="220"/>
                                            <GridViewColumn Header="Status" DisplayMemberBinding="{Binding StatusText}" Width="175"/>
                                            <GridViewColumn Header="Details" DisplayMemberBinding="{Binding Detail}" Width="290"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </StackPanel>
                        </Expander>
                        <DockPanel Margin="0,5,0,0">
                            <Button DockPanel.Dock="Right" VerticalAlignment="Center" Click="OpenBrowserExtensionButton_Click" Margin="10,0,0,0" Padding="12,4" Background="#211A12" BorderBrush="#826028" Foreground="#FFC466" Style="{StaticResource SecondaryButtonStyle}" Content="●  Browser extension"/>
                        <Border x:Name="ActiveTaskCard" Padding="1,4,1,2">
                            <Grid>
                                <DockPanel x:Name="DonutTaskPanel" LastChildFill="True">
                                    <!-- Action Buttons -->

                                    <StackPanel>
                                    <!-- Active Task Header -->


                                    <!-- File Name & Total Size -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="FileNameTextBlock" Text="No active download" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="FileSizeTextBlock" Grid.Column="1" Text="-- / --" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                                    </Grid>

                                    <!-- Apple Pill Progress Bar -->
                                    <ProgressBar x:Name="DownloadProgressBar" Height="5" Value="0" Maximum="100" Background="#322A26" Foreground="#FF9A16" BorderThickness="0">
                                        <ProgressBar.Resources>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </ProgressBar.Resources>
                                    </ProgressBar>

                                    <Grid Margin="0,4,0,2">
                                        <TextBlock x:Name="ProgressPercentTextBlock" Text="0%" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock x:Name="EtaTextBlock" Text="ETA: --:--" FontSize="12" FontWeight="SemiBold" Foreground="#78E2DB" HorizontalAlignment="Right"/>
                                    </Grid>

                                    </StackPanel>

                                </DockPanel>
                                <StackPanel x:Name="SteamTaskPanel" Visibility="Collapsed">
                                    <TextBlock Text="STEAM DOWNLOAD" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="SteamGameName" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,3"/>
                                    <TextBlock x:Name="SteamGameSize" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
