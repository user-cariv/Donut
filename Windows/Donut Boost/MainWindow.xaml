<Window x:Class="DonutBoost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Donut Boost — Network Monitor and Direct Downloader"
        Icon="Assets/Donut.ico"
        WindowState="Maximized"
        Height="800" Width="1100"
        MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#0F1119"
        FontFamily="{StaticResource AppleFontFamily}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <SolidColorBrush x:Key="EthernetOnlineBrush" Color="#FFAB61"/>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Apple Title Bar (Row 0 - Fixed) -->
            <RowDefinition Height="*"/>    <!-- Main Scrollable Content Area (Row 1) -->
            <RowDefinition Height="Auto"/> <!-- Apple Status Bar (Row 2 - Fixed) -->
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="#0F1119" Height="46" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="18,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Left: Traffic Lights & Brand -->
                    <ColumnDefinition Width="*"/>    <!-- Center: Sticky Live Status -->
                    <ColumnDefinition Width="Auto"/> <!-- Right: Actions & Window Controls -->
                </Grid.ColumnDefinitions>

                <!-- Left: Brand Header & License Status -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Image Source="Assets/DonutBoostLogo.png" Width="24" Height="24" Margin="0,0,8,0"/>
                    <TextBlock Text="Donut Boost" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"/>

                    <!-- License Status Pill (Click to view details or renew) -->
                    <Button x:Name="TitleBarLicenseButton" Click="TitleBarLicenseButton_Click" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Margin="10,0,0,0" ToolTip="Click to view license status or enter a new redeem code">
                        <Border x:Name="TitleBarLicenseBadge" Background="#172C31" CornerRadius="12" Padding="10,4">
                            <TextBlock x:Name="TitleBarLicenseText" Text="⚡ PRO: ACTIVE" FontSize="10" FontWeight="Bold" Foreground="#30D158"/>
                        </Border>
                    </Button>

                    <!-- Eye-Catching Official Website CTA Button (Next to License Status) -->
                    <Button Click="OpenWebsiteButton_Click" Cursor="Hand" Margin="10,0,0,0" ToolTip="Visit Official Donut Website (https://user-cariv.github.io/Donut/)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="WebBadgeBorder" CornerRadius="17" Padding="15,7" BorderThickness="1" SnapsToDevicePixels="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#63DED5" Offset="0.0"/>
                                            <GradientStop Color="#7CA4F3" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.BorderBrush>
                                        <SolidColorBrush Color="Transparent"/>
                                    </Border.BorderBrush>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🌐" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Website" FontSize="12" FontWeight="SemiBold" Foreground="#102236" VerticalAlignment="Center"/>
                                        <TextBlock Text="↗" FontSize="11" FontWeight="Black" Foreground="#17304A" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="WebBadgeBorder" Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#A0F0E7" Offset="0.0"/>
                                                    <GradientStop Color="#A1C5FF" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="WebBadgeBorder" Property="BorderBrush" Value="#FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="WebBadgeBorder" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- In-App Update Ready Badge (Top bar alert) -->
                    <Button x:Name="TitleBarUpdateBadge" Click="TitleBarUpdateBadge_Click" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Margin="8,0,0,0" ToolTip="New update is ready! Click to view update details">
                        <Border Background="#2E1065" BorderBrush="#A855F7" BorderThickness="1" CornerRadius="8" Padding="7,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚀 " FontSize="10"/>
                                <TextBlock x:Name="TitleBarUpdateBadgeText" Text="UPDATE READY" FontSize="10" FontWeight="Bold" Foreground="#DDD6FE"/>
                            </StackPanel>
                        </Border>
                    </Button>
                </StackPanel>

                <!-- Center: Live Sticky Status Capsule (Always visible when scrolling) -->
                <Grid Grid.Column="1" Visibility="Collapsed">
                    <StackPanel x:Name="TitleBarLiveStatusPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <Border Background="#241E15" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="12" Padding="14,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TitleBarSpeedTextBlock" Text="0.0 Mbps" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                                <TextBlock x:Name="TitleBarStatusBadge" Text="BOOSTING SPEED" FontWeight="Bold" FontSize="11" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock x:Name="TitleBarProgressText" Text="0% (ETA: --:--)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Right: Utility & Windows Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">

                    <Button x:Name="WifiRoutePreferenceButton" Visibility="Collapsed" Click="PreferWifiRouteButton_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" Margin="0,0,8,0" ToolTip="Restore Windows network settings saved by an older version of Donut Boost.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📶" FontSize="11" Margin="0,0,6,0"/>
                            <TextBlock x:Name="WifiRoutePreferenceText" Text="Prefer Wi-Fi" FontSize="11" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                    <Button Click="RefreshAdaptersButton_Click" Background="#1C1E27" BorderBrush="Transparent" Foreground="#E5E8F3"
                            MinHeight="32" Padding="15,5" Margin="0,6,10,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="Refresh network adapters and connected phones">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="RescanSurface" CornerRadius="17" Background="{TemplateBinding Background}"
                                        BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="RescanSurface" Property="Background" Value="#292E3B"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="RescanSurface" Property="Background" Value="#222632"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="RescanSurface" Property="BorderBrush" Value="#80D9EF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Check for updates" Click="CheckForUpdatesButton_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" FontSize="11" Margin="0,0,6,0"/>
                            <TextBlock Text="Rescan Connections" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="20" Background="#2C303D" Margin="0,0,9,0" VerticalAlignment="Center"/>
                    <Button Click="MinimizeButton_Click" Style="{StaticResource WindowControlButtonStyle}" ToolTip="Minimize">
                        <TextBlock Text="—" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Click="MaximizeRestoreButton_Click" Style="{StaticResource WindowControlButtonStyle}" ToolTip="Maximize / Restore">
                        <TextBlock x:Name="MaximizeIconText" Text="🗖" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                    <Button Click="CloseButton_Click" Style="{StaticResource WindowCloseButtonStyle}" ToolTip="Close">
                        <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Dashboard -->
        <Grid Grid.Row="1" Margin="22,12,22,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0. In-App Auto-Update Banner -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 0. In-App Auto-Update Notification Banner (Appears when new version is available) -->
                <Border x:Name="AppUpdateBanner" Grid.Row="0" Visibility="Collapsed" Background="#1E192B" BorderBrush="#8B5CF6" BorderThickness="1.5" CornerRadius="12" Margin="0,0,0,8" Padding="16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Icon -->
                        <Border Grid.Column="0" Background="#2E1065" CornerRadius="10" Width="38" Height="38" Margin="0,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🚀" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Center: Update Info & Progress -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock x:Name="UpdateBannerTitle" Text="New Donut Boost Update Available" FontSize="13" FontWeight="Bold" Foreground="#EDE9FE"/>
                                <Border Background="#4C1D95" CornerRadius="6" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="UpdateVersionTag" Text="v1.0.8" FontSize="10" FontWeight="Bold" Foreground="#DDD6FE"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="UpdateReleaseNotesText" Text="Keep Windows on home Wi-Fi, improve adapter monitoring, and show verified Steam download progress." FontSize="11" Foreground="#C4B5FD" TextWrapping="Wrap"/>
                            <TextBlock Text="Donut Boost needs to restart after installing the update. If it doesn't reopen automatically, open it from the Windows Start menu."
                                       Margin="0,6,0,0" FontSize="11" Foreground="#E9D5FF" TextWrapping="Wrap"/>

                            <!-- Download Progress Strip -->
                            <Grid x:Name="UpdateProgressPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ProgressBar x:Name="UpdateProgressBar" Height="6" Value="0" Maximum="100" Background="#2E1065" Foreground="#A855F7" BorderThickness="0"/>
                                <TextBlock x:Name="UpdateProgressPercentText" Grid.Row="1" Text="Downloading update... 0%" FontSize="10" Foreground="#DDD6FE" Margin="0,4,0,0"/>
                            </Grid>
                        </StackPanel>

                        <!-- Right: Actions -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <Button x:Name="UpdateNowButton" Click="UpdateNowButton_Click" Style="{StaticResource BoostButtonStyle}" Padding="14,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⬇" Margin="0,0,6,0" FontWeight="Bold"/>
                                    <TextBlock x:Name="UpdateNowButtonText" Text="Update Now" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                            <Button Click="DismissUpdateBanner_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6" ToolTip="Dismiss for now">
                                <TextBlock Text="✕" FontSize="13" Foreground="#8B5CF6"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Download dashboard -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.46*" MinWidth="278"/> <!-- Left: Speedometer & Active Task -->
                        <ColumnDefinition Width="*"/>     <!-- Right: Connected Networks -->
                    </Grid.ColumnDefinitions>

                    <!-- Speed, active download and system log -->
                    <Grid Grid.Column="0" Margin="0,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1.25*" MinHeight="108" MaxHeight="258"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Apple-Style Circular Activity Gauge Card -->
                        <Border Grid.Row="0" Background="#171A25" BorderBrush="#272B38" BorderThickness="1" CornerRadius="24" Padding="14,8" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Width="110">
                                        <Grid Width="110" Height="110">
                                            <Border CornerRadius="55" BorderBrush="#344963" BorderThickness="4" Background="#171D2B"/>
                                            <Border CornerRadius="55" BorderBrush="#80D9EF" BorderThickness="1" Margin="4" Opacity="0.52"/>
                                            <Ellipse Width="9" Height="9" Fill="#80BBF3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock x:Name="CombinedSpeedTextBlock" Text="0.0" FontSize="39" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="CombinedSpeedUnitTextBlock" Text="MBPS" FontSize="12" FontWeight="Bold"
                                                           Foreground="#A3B1CC" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="StatusBadgeTextBlock" Text="Ready" FontSize="19" FontWeight="SemiBold"
                                                   Foreground="#A4E5F3" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock Text="COMBINED RECEIVE RATE" FontSize="19" FontWeight="Bold"
                                                   Foreground="#FFFFFF" TextWrapping="Wrap"/>
                                        <StackPanel Margin="0,12,0,0">
                                            <TextBlock x:Name="WifiSummaryText" Text="Wi-Fi: Off" FontSize="16" FontWeight="SemiBold" Foreground="#54DB87"/>
                                            <TextBlock x:Name="TetherSummaryText" Text="Ethernet: Off" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Active Task Card -->
                        <Border x:Name="ActiveTaskCard" Grid.Row="1" Background="#171A25" BorderBrush="#272B38" BorderThickness="1" CornerRadius="24" Padding="14,7" Margin="0,0,0,6">
                            <DockPanel LastChildFill="True">
                                <!-- Action Buttons -->
                                <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,4,0,0">
                                    <Button x:Name="PauseResumeButton" Click="PauseResumeButton_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,8,0" IsEnabled="False">
                                        <TextBlock x:Name="PauseResumeButtonText" Text="⏸ Pause"/>
                                    </Button>
                                    <Button x:Name="CancelDownloadButton" Click="CancelDownloadButton_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,8,0" IsEnabled="False">
                                        <TextBlock Text="✕ Cancel"/>
                                    </Button>
                                    <Button x:Name="OpenFolderButton" Click="OpenFolderButton_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" IsEnabled="False">
                                        <TextBlock Text="📁 Open Folder"/>
                                    </Button>
                                </WrapPanel>
                                <StackPanel>
                                <!-- Active Task Header -->
                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="ACTIVE TASK" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- File Name & Total Size -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="FileNameTextBlock" Text="No active download" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="FileSizeTextBlock" Grid.Column="1" Text="-- / --" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                                </Grid>

                                <!-- Apple Pill Progress Bar -->
                                <ProgressBar x:Name="DownloadProgressBar" Height="5" Value="0" Maximum="100" Background="#2A3346" Foreground="#78D9E4">
                                    <ProgressBar.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </ProgressBar.Resources>
                                </ProgressBar>

                                <Grid Margin="0,4,0,2">
                                    <TextBlock x:Name="ProgressPercentTextBlock" Text="0%" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock x:Name="EtaTextBlock" Text="ETA: --:--" FontSize="12" FontWeight="SemiBold" Foreground="#78E2DB" HorizontalAlignment="Right"/>
                                </Grid>

                                </StackPanel>

                            </DockPanel>
                        </Border>
                        <Border x:Name="SystemLogCard" Grid.Row="2" Margin="0,0,0,8" Background="#0D0F16" BorderBrush="#232633" BorderThickness="1" CornerRadius="14"
                                Padding="12,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="SYSTEM LOG" FontSize="12" FontWeight="Bold" Foreground="#AABAD2"/>
                                    <Ellipse Width="5" Height="5" Fill="#78E2DB" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ScrollViewer x:Name="SystemLogViewport" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="LogOutputTextBlock" Text="Ready." FontSize="11" FontFamily="Consolas"
                                               Foreground="#B1BED2" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Right Column: independently measured network adapters -->
                    <Grid Grid.Column="1" Margin="4,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="#1C2130" BorderBrush="#30384B" BorderThickness="1" CornerRadius="16" Padding="14,12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Row 0: URL Input -->
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="#121214" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="4,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🔗" FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,0,6,0"/>
                                        <TextBox x:Name="UrlTextBox" Grid.Column="1" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Background="Transparent" BorderThickness="0" Padding="4,7" VerticalContentAlignment="Center" AutomationProperties.Name="Download link" ToolTip="Direct HTTP(S) URL, magnet link, or path to a .torrent file"/>
                                        <TextBlock Grid.Column="1" Text="Paste a download link" Margin="4,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=UrlTextBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <Button x:Name="PasteDownloadButton" Grid.Column="1" MinHeight="36" Padding="12,5" Click="PasteUrlButton_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" ToolTip="Paste URL from Clipboard">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📋" FontSize="11" Margin="0,0,5,0"/>
                                        <TextBlock Text="Paste"/>
                                    </StackPanel>
                                </Button>


                                <Button x:Name="TorrentDownloadButton" Grid.Column="2" MinHeight="36" Padding="12,5" Click="SelectTorrentButton_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" ToolTip="Choose a .torrent file">
                                    <TextBlock Text="Torrent"/>
                                </Button>

                                <Button x:Name="StartBoostButton" Grid.Column="3" MinHeight="36" Padding="14,5" Click="StartBoostButton_Click" Style="{StaticResource BoostButtonStyle}" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡" FontSize="13" Margin="0,0,6,0"/>
                                        <TextBlock Text="Download"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="OutputFolderTextBlock" Grid.Row="1" Margin="0,9,4,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                <Button x:Name="BrowserExtensionButton" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                        Content="Browser extension" HorizontalAlignment="Center" Margin="8,9,0,0"
                                        Click="OpenBrowserExtensionButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                <Button Grid.Row="1" Grid.Column="3" Content="Change folder" HorizontalAlignment="Right"
                                        Margin="8,9,0,0" Click="BrowseFolderButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                            </Grid>
                        </Border>
                        <Border x:Name="NetworkAdaptersCard" Grid.Row="1" Margin="0,0,0,8" Background="#171A25" BorderBrush="#272B38" BorderThickness="1" CornerRadius="24" Padding="14,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="NETWORK ADAPTERS  &#xB7;  LIVE" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="AdapterCountTextBlock" Grid.Column="1" Text="0 Detected" FontSize="11" FontWeight="Bold" Foreground="#78E2DB"/>
                                </Grid>

                                <TextBlock Grid.Row="1" Text="Live rates show all Windows traffic on each physical connection. Switches and limits apply to Donut downloads." FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                <!-- Adapters List -->
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="AdaptersItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1D2130" CornerRadius="17" Padding="12" Margin="0,0,0,9">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Squircle Icon Container -->
                                                        <Border Width="38" Height="38" CornerRadius="9" Background="#2A3149" Margin="0,0,10,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding IconGlyph}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Info -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <WrapPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,6,0"/>
                                                                <Border Background="#282830" CornerRadius="4" Padding="5,1">
                                                                    <TextBlock Text="{Binding TypeLabel}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                                                </Border>
                                                                <Border Background="#1A2520" BorderBrush="{Binding RoleBadgeColor}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="6,0,0,0">
                                                                    <TextBlock Text="{Binding RoleBadgeText}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding RoleBadgeColor}"/>
                                                                </Border>
                                                            </WrapPanel>
                                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                            <TextBlock Text="{Binding LocalIp}" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- Live speed and adapter controls -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplaySpeed}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right"/>
                                                                <TextBlock Text="{Binding FormattedTotalBytes, StringFormat='Donut received: {0}'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,1,0,3"/>
                                                            </StackPanel>
                                                            <Button Content="Limits" Click="EditAdapterLimits_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Padding="8,3" Margin="10,0,10,0" VerticalAlignment="Center" FontSize="10"/>
                                                            <ToggleButton IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                          Style="{StaticResource ModernToggleSwitchStyle}"
                                                                          Click="AdapterToggle_Click"
                                                                          ToolTip="{Binding ToggleTooltip}"
                                                                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                    </Border>
                    </Grid>
                </Grid>
        </Grid>

        <!-- Fixed Apple Bottom Status Bar -->
        <Border Grid.Row="2" Visibility="Collapsed" Background="#161618" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="18,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Mode and Connections -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="FooterStatusModeText" Text="⚡ Donut downloads: all selected adapters" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0"/>
                    <TextBlock Text="•" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,12,0"/>
                    <TextBlock x:Name="FooterActiveConnectionsText" Text="0 selected adapters" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0"/>
                    <TextBlock Text="•" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,12,0"/>
                    <TextBlock x:Name="FooterLicenseText" Text="⚡ License: Lifetime" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,12,0"/>
                    <TextBlock Text="•" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,12,0"/>

                    <Button Click="CheckForUpdatesButton_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0" ToolTip="Check for app updates">
                        <TextBlock x:Name="FooterUpdateCheckText" Text="Check for Updates" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" TextDecorations="Underline"/>
                    </Button>
                </StackPanel>

                <!-- Right: Speed & Overall Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="FooterLiveSpeedText" Text="0.0 Mbps" FontWeight="Bold" FontSize="12" Foreground="{StaticResource SuccessBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="•" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="FooterProgressText" Text="Ready to Boost" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- Apple Activation Gate / Blank Page Asking for Redeem Code      -->
        <!-- Displayed on install until a valid redeem code is activated     -->
        <!-- ============================================================== -->
        <Grid x:Name="ActivationOverlayGrid" Grid.Row="1" Grid.RowSpan="2" Background="#141416" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,40">
                    <!-- Apple macOS Frosted Acrylic Activation Card (Crisp Hairline Border) -->
                    <Border Width="520" Background="#1C1C1E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="34,30">
                        <StackPanel HorizontalAlignment="Center" Width="440">
                            <!-- Logo Container with Glowing Ring -->
                            <Border Width="68" Height="68" CornerRadius="18" Background="#242018" BorderBrush="#FF9F0A" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Grid>
                                    <Ellipse Width="56" Height="56" Fill="#FF9F0A" Opacity="0.12"/>
                                    <Image Source="Assets/DonutBoostLogo.png" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Border>

                            <!-- Title & Subtitle -->
                            <TextBlock Text="Unlock Donut Boost" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Enter your redeem code to activate Donut Boost features on this device." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                            <!-- Code Input Box -->
                            <Border Background="#121214" BorderBrush="#383842" BorderThickness="1.5" CornerRadius="11" Padding="12,6" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="RedeemCodeTextBox" FontFamily="Consolas, -apple-system, sans-serif" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" TextAlignment="Center" CharacterCasing="Upper" MaxLength="19" Text="" KeyDown="RedeemCodeTextBox_KeyDown" ToolTip="Format: XXXX-XXXX-XXXX-XXXX"/>
                                    <Button Grid.Column="1" Click="PasteRedeemCode_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="6,0,0,0" ToolTip="Paste code from clipboard">
                                        <TextBlock Text="📋 Paste" FontSize="11"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Status / Error Message -->
                            <TextBlock x:Name="ActivationStatusTextBlock" Text="" FontSize="11" FontWeight="SemiBold" Foreground="#FF453A" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,14" Visibility="Collapsed"/>

                            <!-- Supported Passes Showcase -->
                            <Border Background="#16161A" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⚡ 1 Day" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="⚡ 7 Days" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="⚡ 1 Month" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="⚡ Lifetime" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Primary Activate Button -->
                            <Button x:Name="RedeemCodeButton" Click="RedeemCodeButton_Click" Style="{StaticResource BoostButtonStyle}" Height="44" HorizontalAlignment="Stretch" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="⚡" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="ACTIVATE &amp; UNLOCK APP" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <!-- Optional Free Trial Pass (Once per device) -->
                            <Button x:Name="ActivateTrialButton" Click="ActivateTrialButton_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,0,10">
                                <TextBlock Text="🎁 Or Start 24-Hour Free Pass (Once per device)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" TextDecorations="Underline" HorizontalAlignment="Center"/>
                            </Button>

                            <!-- Official Website Link Button -->
                            <Button Click="OpenWebsiteButton_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,0,12" ToolTip="Visit https://user-cariv.github.io/Donut/">
                                <Border Background="#25252E" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="12,5">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="🌐" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="VISIT WEBSITE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="↗" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Button>

                            <!-- Cancel / Return to App button -->
                            <Button x:Name="CloseActivationSheetButton" Click="CloseActivationSheetButton_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed">
                                <TextBlock Text="✕ Back to Donut Boost" FontSize="11"/>
                            </Button>

                            <!-- Device Hardware ID -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <TextBlock Text="Device ID: " FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="HwidTextBlock" Text="XXXX-XXXX-XXXX" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
