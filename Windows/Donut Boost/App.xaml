<Application x:Class="DonutBoost.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Apple macOS Dark Mode Color Palette -->
        <Color x:Key="BgColor">#09080E</Color>
        <Color x:Key="SurfaceColor">#171421</Color>
        <Color x:Key="SurfaceSubtleColor">#14111D</Color>
        <Color x:Key="SurfaceHoverColor">#28223A</Color>
        <Color x:Key="BorderColor">#2A2638</Color>
        <Color x:Key="BorderLightColor">#38383A</Color>
        
        <!-- Apple Accents -->
        <Color x:Key="AppleAmberColor">#FF9F0A</Color>
        <Color x:Key="AppleAmberLightColor">#FFB340</Color>
        <Color x:Key="AppleGreenColor">#30D158</Color>
        <Color x:Key="AppleGreenDarkColor">#0A3818</Color>
        <Color x:Key="AppleBlueColor">#0A84FF</Color>
        <Color x:Key="ApplePurpleColor">#BF5AF2</Color>
        <Color x:Key="AppleRedColor">#FF453A</Color>
        
        <!-- Apple Typography Colors -->
        <Color x:Key="TextPrimaryColor">#F5F5F7</Color>
        <Color x:Key="TextSecondaryColor">#A1A1A6</Color>
        <Color x:Key="TextMutedColor">#76767A</Color>
        <Color x:Key="TextDimColor">#545458</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
        <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="{StaticResource SurfaceSubtleColor}"/>
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="CardBorderLightBrush" Color="{StaticResource BorderLightColor}"/>
        
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AppleAmberColor}"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AppleAmberLightColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource AppleGreenColor}"/>
        <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource AppleBlueColor}"/>
        <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource ApplePurpleColor}"/>
        <SolidColorBrush x:Key="RedBrush" Color="{StaticResource AppleRedColor}"/>
        
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>

        <!-- Default Font Family across entire app -->
        <FontFamily x:Key="AppleFontFamily">Segoe UI Variable Display, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif</FontFamily>

        <!-- Global TextBlock Sharp Rendering Style (Crisp ClearType across all DPIs) -->
        <Style TargetType="TextBlock">
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Apple Primary Action Button (Gradient Amber with crisp styling) -->
        <Style x:Key="BoostButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppleFontFamily}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFB63E" Offset="0.0"/>
                                    <GradientStop Color="#FF8A00" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFCB72" Offset="0.0"/>
                                            <GradientStop Color="#FFAA2C" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compatibility key used by early 1.0.x window markup. -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BoostButtonStyle}"/>

        <!-- Apple Secondary / Glass Button -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppleFontFamily}"/>
            <Setter Property="Background" Value="#28223A"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#323236"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource CardBorderLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#222225"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Apple macOS Segmented Pill Radio Button -->
        <Style x:Key="ModeRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource AppleFontFamily}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Authentic iOS / macOS Pill Toggle Switch -->
        <Style x:Key="ModernToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="#344054"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border CornerRadius="13" Width="48" Height="26">
                            <Border.Background><SolidColorBrush Color="#3A3748"/></Border.Background>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.93"/></Trigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid x:Name="SwitchSurface" Background="Transparent">
                                <Border x:Name="OnTint" CornerRadius="13" Background="#22C55E" Opacity="0"/>
                                <Ellipse x:Name="Knob" Width="22" Height="22" Fill="#FFFFFF" Margin="2,0,0,0" HorizontalAlignment="Left">
                                    <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="22" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="OnTint" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="OnTint" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS Traffic Light Button Styles -->
        <Style x:Key="MacTrafficCloseStyle" TargetType="Button">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="circle" Fill="#FF5F56" Stroke="#E0443E" StrokeThickness="0.6"/>
                            <TextBlock x:Name="glyph" Text="✕" FontSize="8" FontWeight="Black" Foreground="#4D0000" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" Margin="0,-1,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="glyph" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="circle" Property="Fill" Value="#E0443E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MacTrafficMinStyle" TargetType="Button">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="circle" Fill="#FFBD2E" Stroke="#DEA123" StrokeThickness="0.6"/>
                            <TextBlock x:Name="glyph" Text="—" FontSize="8" FontWeight="Black" Foreground="#523600" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" Margin="0,-2,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="glyph" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="circle" Property="Fill" Value="#DEA123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MacTrafficZoomStyle" TargetType="Button">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="circle" Fill="#27C93F" Stroke="#1AAB29" StrokeThickness="0.6"/>
                            <TextBlock x:Name="glyph" Text="+" FontSize="9" FontWeight="Black" Foreground="#004D11" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" Margin="0,-1.5,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="glyph" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="circle" Property="Fill" Value="#1AAB29"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Title Bar Utility Buttons -->
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppleFontFamily}"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2C2C30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppleFontFamily}"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF453A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Apple ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsMouseOver}">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="4" Background="#3E3E44" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
