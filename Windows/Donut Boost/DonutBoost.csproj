<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DonutBoost</AssemblyName>
    <RootNamespace>DonutBoost</RootNamespace>
    <Product>Donut Boost</Product>
    <Company>Donut</Company>
    <Authors>Donut</Authors>
    <Description>Donut Boost - Network Monitor and Direct Downloader</Description>
    <Version>1.0.11</Version>
    <ApplicationIcon>Assets\Donut.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\**" />
    <None Remove="photos\**" />
    <Resource Include="Assets\**" />
    <Resource Include="photos\**" />
  </ItemGroup>

  <Target Name="VerifyWpfRuntime" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true'">
    <Error Condition="!Exists('$(PublishDir)Accessibility.dll')" Text="The self-contained WPF runtime is missing Accessibility.dll, which is required to open tooltips." />
  </Target>
</Project>
