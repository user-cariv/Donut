<Window x:Class="DonutLock.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Donut Lock" Height="650" Width="850" MinHeight="520" MinWidth="700" Background="#F7F7FB" WindowStartupLocation="CenterScreen">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="White" Padding="26"><DockPanel><Button DockPanel.Dock="Right" Content="Add items" Background="#5148E5" Foreground="White" FontWeight="SemiBold" Click="Add_Click"/><StackPanel Orientation="Horizontal"><Border CornerRadius="14" Margin="0,0,14,0" ClipToBounds="True"><Image Source="Assets/donut-lock-logo.jpeg" Width="58" Height="58" Stretch="UniformToFill"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Donut Lock" FontSize="23" FontWeight="Bold"/><TextBlock Text="Your private file vault" Foreground="#72738A" Margin="0,3,0,0"/></StackPanel></StackPanel></DockPanel></Border>
  <DockPanel Grid.Row="1" Margin="26,22,26,10"><TextBlock Text="VAULT ITEMS" FontWeight="Bold" Foreground="#72738A"/><TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="#72738A"/></DockPanel>
  <Grid Grid.Row="2" Margin="18,0,18,12"><ListView x:Name="Items" BorderThickness="0" Background="Transparent"><ListView.ItemTemplate><DataTemplate><Border Background="White" CornerRadius="12" Padding="13" Margin="4"><DockPanel><Button DockPanel.Dock="Right" Content="Unlock" Click="Unlock_Click"/><Button DockPanel.Dock="Right" Content="Delete" Click="Delete_Click"/><StackPanel><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Encrypted vault copy" Foreground="#7A7B90" FontSize="12" Margin="0,4,0,0"/></StackPanel></DockPanel></Border></DataTemplate></ListView.ItemTemplate></ListView><StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="Assets/donut-lock-logo.jpeg" Width="118" Height="118" Stretch="UniformToFill"/><TextBlock Text="Your vault is ready" FontSize="21" FontWeight="SemiBold" Margin="0,12,0,4" HorizontalAlignment="Center"/><TextBlock Text="Add a file or folder to create an encrypted copy." Foreground="#72738A"/></StackPanel></Grid>
  <Border Grid.Row="3" Background="#ECECF4" Padding="14"><TextBlock x:Name="StatusText" Text="Encrypted copies are stored in your user profile." Foreground="#62637A" TextWrapping="Wrap"/></Border>
 </Grid>
</Window>
